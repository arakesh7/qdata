# QDATA Configuration Template
# Copy this file to .env and fill in your credentials.
# IMPORTANT: Never commit your actual .env file or credentials to Git.

# Core Settings
QDATA_DATA_DIR=data
QDATA_DEFAULT_PROVIDER=mock
QDATA_DEFAULT_EXCHANGE=NSE
QDATA_DEFAULT_CURRENCY=INR
QDATA_DEFAULT_ASSET_CLASS=EQUITY
QDATA_LOG_LEVEL=INFO

# Fyers Provider Credentials
QDATA_FYERS_CLIENT_ID=your_fyers_client_id
QDATA_FYERS_SECRET_KEY=your_fyers_secret_key
QDATA_FYERS_REDIRECT_URI=http://localhost.com

# Upstox Provider Credentials
QDATA_UPSTOX_API_KEY=your_upstox_api_key
QDATA_UPSTOX_API_SECRET=your_upstox_api_secret

# AMFI Provider Network Settings (Optional)
QDATA_AMFI_TIMEOUT=60
QDATA_AMFI_CHUNK_DAYS=730
QDATA_AMFI_MAX_RETRIES=4
QDATA_AMFI_RATE_LIMIT_DELAY=0.3
